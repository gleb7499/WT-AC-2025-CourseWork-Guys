// This is your Prisma schema file for Volunteer Help System
// Based on R1_ERD.md documentation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
  volunteer
}

enum HelpRequestStatus {
  new
  assigned
  in_progress
  completed
  cancelled
}

enum AssignmentStatus {
  assigned
  in_progress
  completed
  cancelled
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  helpRequests      HelpRequest[]
  volunteerProfile  VolunteerProfile?
  assignments       Assignment[]
  reviewsGiven      Review[]          @relation("ReviewsGiven")
  reviewsReceived   Review[]          @relation("ReviewsReceived")

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  helpRequests HelpRequest[]

  @@map("categories")
}

model HelpRequest {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  categoryId      String            @map("category_id")
  title           String
  description     String
  status          HelpRequestStatus @default(new)
  locationLat     Float?            @map("location_lat")
  locationLng     Float?            @map("location_lng")
  locationAddress String            @map("location_address")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  assignments Assignment[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@map("help_requests")
}

model VolunteerProfile {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  bio         String?
  rating      Float   @default(0)
  totalHelps  Int     @default(0) @map("total_helps")
  locationLat Float?  @map("location_lat")
  locationLng Float?  @map("location_lng")
  categories  String[] // Array of category IDs
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("volunteer_profiles")
}

model Assignment {
  id           String           @id @default(uuid())
  requestId    String           @map("request_id")
  volunteerId  String           @map("volunteer_id")
  status       AssignmentStatus @default(assigned)
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  completedAt  DateTime?        @map("completed_at")

  // Relations
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  volunteer User        @relation(fields: [volunteerId], references: [id])
  review    Review?

  @@index([requestId])
  @@index([volunteerId])
  @@index([status])
  @@map("assignments")
}

model Review {
  id           String   @id @default(uuid())
  assignmentId String   @unique @map("assignment_id")
  userId       String   @map("user_id")
  volunteerId  String   @map("volunteer_id")
  rating       Int
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation("ReviewsGiven", fields: [userId], references: [id])
  volunteer  User       @relation("ReviewsReceived", fields: [volunteerId], references: [id])

  @@index([volunteerId])
  @@map("reviews")
}
