# Database Configuration
# PostgreSQL connection string for the application database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# JWT Authentication Secrets
# IMPORTANT: Generate unique secure secrets for production (minimum 32 characters)
# You can use: openssl rand -base64 32
JWT_ACCESS_SECRET=your-access-secret-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters-long-change-in-production

# JWT Token Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# Frontend URL for CORS whitelist
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Frontend Configuration (for Vite)
VITE_API_URL=http://localhost:3000/api
