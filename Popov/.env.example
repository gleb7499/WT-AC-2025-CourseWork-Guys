# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# JWT (GENERATE UNIQUE secrets for production - minimum 32 characters!)
# For development, you can use these or set your own
JWT_ACCESS_SECRET=dev-access-secret-min-32-chars-CHANGE-IN-PRODUCTION
JWT_REFRESH_SECRET=dev-refresh-secret-min-32-chars-CHANGE-IN-PRODUCTION

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api
